# Domain
DOMAIN=coacc.example.com

# Neo4j
NEO4J_PASSWORD=changeme
NEO4J_AUTH=none
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED=false
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=2G
NEO4J_HEAP_MAX=3G
NEO4J_PAGECACHE=1G
NEO4J_TX_TOTAL_MAX=3G

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
APP_ENV=dev
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
INVITE_CODE=
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:3100,http://127.0.0.1:5173,http://127.0.0.1:5174
AUTH_COOKIE_SECURE=false
PRODUCT_TIER=community
PATTERNS_ENABLED=true
PUBLIC_MODE=false
PUBLIC_ALLOW_PERSON=false
PUBLIC_ALLOW_ENTITY_LOOKUP=false
PUBLIC_ALLOW_INVESTIGATIONS=false
PATTERN_SPLIT_THRESHOLD_VALUE=80000
PATTERN_SPLIT_MIN_COUNT=3
PATTERN_SHARE_THRESHOLD=0.6
PATTERN_SRP_MIN_ORGS=5
PATTERN_INEXIG_MIN_RECURRENCE=3
PATTERN_MAX_EVIDENCE_REFS=50

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_ALLOW_FIXTURES=true
VITE_PUBLIC_MODE=false
VITE_PATTERNS_ENABLED=true

# Lake / ETL
COACC_LAKE_ROOT=
COACC_CONFIG_DIR=
COACC_DATASET_CATALOG_DIR=
COACC_DATASET_CONTRACT_DIR=
COACC_REQUIRE_LAKE_ASSETS=false
COACC_READY_MIN_LOADED_SOURCES=0
COACC_READY_MAX_LAKE_OPS_AGE_HOURS=0
COACC_SIGNALS_REQUIRE_MATERIALIZED=false
COACC_HOST_LAKE_ROOT=../../lake
COACC_HOST_CONFIG_DIR=../../config
COACC_HOST_DATASET_CATALOG_DIR=../../docs/datasets
COACC_HOST_DATASET_CONTRACT_DIR=../../etl/datasets
COACC_LAKE_OPS_MODE=refresh
COACC_LAKE_OPS_RUN_ID_PREFIX=prod
COACC_LAKE_OPS_CONTINUE_ON_ERROR=true
COACC_LAKE_OPS_ALLOW_FULL=false
COACC_LAKE_OPS_SKIP_REALITY=false
COACC_LAKE_OPS_PAGE_SIZE=
COACC_LAKE_OPS_MAX_PAGES=
COACC_LAKE_OPS_TIMEOUT_SECONDS=
COACC_LAKE_OPS_MIN_FREE_GB=
COACC_LAKE_OPS_CRON_SCHEDULE=15 2 * * *
COACC_LAKE_OPS_ALERT_WEBHOOK_URL=
COACC_LAKE_OPS_ALERT_NAME=coacc-lake-ops
COACC_BACKUP_DIR=./backups
COACC_BACKUP_RETENTION_DAYS=30
COACC_BACKUP_VERIFY_CONTRACTS=true
COACC_LAKE_BACKUP_CRON_SCHEDULE=45 3 * * *
COACC_RESTORE_ROOT=
COACC_RESTORE_OVERWRITE=false
COACC_PROD_SMOKE_BASE_URL=
COACC_PROD_SMOKE_WAIT_TIMEOUT=120
COACC_PROD_SMOKE_INSECURE=true
COACC_PROD_SMOKE_SKIP=false
COACC_PROD_SMOKE_SKIP_FRONTEND=false
COACC_PROD_SMOKE_REQUIRE_OPS=true
COACC_PROD_SMOKE_REQUIRE_MATERIALIZED_ONLY=true
COACC_SOCRATA_PAGE_SIZE=10000
COACC_SOCRATA_MAX_PAGES=10000
COACC_SOCRATA_TIMEOUT_SECONDS=60
COACC_SOCRATA_MAX_TIMEOUT_SECONDS=240
COACC_WATERMARK_FUTURE_GRACE_DAYS=1

# Socrata / LLM providers
SOCRATA_APP_TOKEN=
SOCRATA_KEY_ID=
SOCRATA_KEY_SECRET=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
